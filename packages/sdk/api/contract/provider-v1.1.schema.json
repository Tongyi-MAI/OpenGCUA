    {"type":"object","required":["op","operation","_request_id","tab_id","id"],"properties":{"op":{"const":"browser"},"operation":{"const":"artifact_read"},"_request_id":{"type":"integer"},"tab_id":{"type":"string"},"id":{"type":"string"},"offset":{"type":"integer","minimum":0},"max_bytes":{"type":"integer","minimum":1,"maximum":1048576}},"additionalProperties":true}
  ]
